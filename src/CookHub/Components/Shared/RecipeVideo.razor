@* Plays a recipe's video: YouTube and Vimeo in their own player, video files in the browser's player. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Video is { Kind: VideoEmbedKind.Player })
{
    <div class="recipe-video @Class" @ref="_container">
        <iframe src="@Video.ControllableSrc" title="@Title" loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
}
else if (Video is { Kind: VideoEmbedKind.File })
{
    <div class="recipe-video @Class" @ref="_container">
        <video src="@Video.Src" title="@Title" controls preload="metadata" playsinline></video>
    </div>
}

@code {
    private ElementReference _container;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired] public VideoEmbed? Video { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    // Jumps the video to the given number of seconds from the start and plays it.
    public async Task SeekAsync(int seconds)
    {
        if (Video is null)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/RecipeVideo.razor.js");
            await _module.InvokeVoidAsync("seek", _container, seconds);
        }
        catch (JSDisconnectedException)
        {
            // The browser has gone; there is no player to move.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
