<div class="d-flex align-center py-1">
    <MudCheckBox T="bool" Value="OnHand" ValueChanged="OnHandChanged" Color="Color.Success" Dense="true" aria-label="@($"I have {Name}")" />
    <div class="@(OnHand ? "on-hand-text" : null)">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool OnHand { get; set; }
    [Parameter] public EventCallback<bool> OnHandChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
