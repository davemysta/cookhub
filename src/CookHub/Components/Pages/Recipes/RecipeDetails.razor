@page "/recipes/{Id:int}"
@inject RecipeService Recipes
@inject PantryService Pantry
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_recipe?.Title ?? "Recipe") · CookHub</PageTitle>

<MudButton Href="recipes" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">All recipes</MudButton>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_recipe is null)
{
    <MudAlert Severity="Severity.Warning">That recipe doesn't exist, or it isn't one of yours.</MudAlert>
}
else
{
    <div class="d-flex align-center flex-wrap gap-2 mb-4">
        <MudText Typo="Typo.h4">@_recipe.Title</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SoupKitchen" OnClick="EnterCookingModeAsync">Cooking Mode</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="AddToPlanAsync">Add to meal plan</MudButton>
        <MudButton Href="@($"recipes/{Id}/edit")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        <MudTooltip Text="Delete recipe">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Delete recipe" OnClick="DeleteAsync" />
        </MudTooltip>
    </div>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="5">
            @if (_video is not null)
            {
                @* Cooking mode moves this same player into its top-left panel with CSS, so the video keeps playing. *@
                <RecipeVideo @ref="_player" Video="_video" Title="@($"{_recipe.Title} video")" Class="@(_cooking ? "cooking-video" : "mb-4")" />
            }
            else
            {
                <img src="@_recipe.ImageUrl" alt="@_recipe.Title" class="recipe-hero mb-4" />
            }

            @if (!string.IsNullOrEmpty(_recipe.Description))
            {
                <MudText Class="mb-4" Style="white-space: pre-line;">@_recipe.Description</MudText>
            }

            @if (_recipe.Tags.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mb-4">
                    @foreach (var tag in _recipe.Tags)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Variant="Variant.Outlined">@tag.Name</MudChip>
                    }
                </div>
            }

            <MudPaper Outlined="true" Class="pa-4">
                <div class="d-flex align-center gap-2 mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" Size="Size.Small" />
                    <MudText Typo="Typo.h6">Liked by</MudText>
                </div>
                @foreach (var entry in _likedBy)
                {
                    <MudCheckBox T="bool" Value="entry.Liked" ValueChanged="@(liked => SetLikedAsync(entry, liked))" Color="Color.Error" Dense="true"
                                 Label="@(entry.Person.IsMe ? $"{entry.Person.Name} (me)" : entry.Person.Name)" />
                }
                @if (_likedBy.Count == 1)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Add <MudLink Href="family" Typo="Typo.caption">family members</MudLink> to track what they like too.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            @if (!_cooking)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4">
                    @IngredientsHeader
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Tick what you already have and it's added to your <MudLink Href="on-hand" Typo="Typo.caption">On hand</MudLink> list.</MudText>
                    @IngredientsList
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Steps</MudText>
                    @StepsList
                </MudPaper>
            }
        </MudItem>
    </MudGrid>

    @if (_cooking)
    {
        <div class="cooking-mode" role="dialog" aria-modal="true" aria-label="@($"Cooking {_recipe.Title}")">
            <div class="cooking-bar">
                <MudIcon Icon="@Icons.Material.Filled.SoupKitchen" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle1" Class="cooking-title">@_recipe.Title</MudText>
                <MudSpacer />
                @if (_doneSteps.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary d-none d-sm-flex">@_doneSteps.Count of @_recipe.Steps.Count steps done</MudText>
                    <MudTooltip Text="Clear the ticked steps">
                        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" aria-label="Clear the ticked steps" OnClick="@(() => _doneSteps.Clear())" />
                    </MudTooltip>
                }
                @if (_wakeLockSupported)
                {
                    <MudTooltip Text="@(_screenAwake ? "The screen will stay on" : "Couldn't keep the screen on; it may turn off as usual")">
                        <MudIcon Icon="@(_screenAwake ? Icons.Material.Filled.LightMode : Icons.Material.Outlined.Bedtime)"
                                 Color="@(_screenAwake ? Color.Warning : Color.Default)" Size="Size.Small" Class="mx-1"
                                 aria-label="@(_screenAwake ? "Screen stays on" : "Screen may turn off")" />
                    </MudTooltip>
                }
                @if (_fullscreenSupported)
                {
                    <MudTooltip Text="@(_fullscreen ? "Leave full screen" : "Full screen")">
                        <MudIconButton Icon="@(_fullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Size="Size.Small"
                                       aria-label="@(_fullscreen ? "Leave full screen" : "Full screen")" OnClick="ToggleFullscreenAsync" />
                    </MudTooltip>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close"
                           OnClick="ExitCookingModeAsync" Class="ml-1 text-nowrap">
                    <span class="d-none d-sm-inline">Exit cooking mode</span><span class="d-sm-none">Exit</span>
                </MudButton>
            </div>
            <div class="cooking-grid">
                <div class="cooking-video-slot">
                    @if (_video is null)
                    {
                        <img src="@_recipe.ImageUrl" alt="@_recipe.Title" />
                    }
                </div>
                <MudPaper Outlined="true" Class="cooking-panel cooking-ingredients">
                    <div class="cooking-panel-header">@IngredientsHeader</div>
                    <div class="cooking-panel-body">@IngredientsList</div>
                </MudPaper>
                <MudPaper Outlined="true" Class="cooking-panel cooking-steps">
                    <div class="cooking-panel-header">
                        <MudText Typo="Typo.h6">Steps</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Tap a step's number to tick it off.</MudText>
                    </div>
                    <div class="cooking-panel-body">@StepsList</div>
                </MudPaper>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private RecipeDetailsModel? _recipe;
    private VideoEmbed? _video;
    private RecipeVideo? _player;
    private List<RecipeIngredientLine> _ingredients = [];
    private List<LikedByEntry> _likedBy = [];

    // Cooking mode
    private bool _cooking;
    private bool _fullscreen;
    private bool _fullscreenSupported;
    private bool _screenAwake;
    private bool _wakeLockSupported;
    private readonly HashSet<int> _doneSteps = [];
    private IJSObjectReference? _cookingModule;
    private DotNetObjectReference<RecipeDetails>? _selfRef;

    [Parameter] public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _doneSteps.Clear();
        _recipe = await Recipes.GetAsync(Id);
        _video = VideoEmbed.Parse(_recipe?.VideoUrl);
        _ingredients = _recipe?.Ingredients.ToList() ?? [];
        _likedBy = _recipe?.LikedBy.ToList() ?? [];
        _loading = false;
    }

    private async Task SetOnHandAsync(RecipeIngredientLine line, bool onHand)
    {
        await Pantry.SetOnHandAsync(line.IngredientId, onHand);
        // The same ingredient can appear on more than one line.
        _ingredients = _ingredients.Select(i => i.IngredientId == line.IngredientId ? i with { OnHand = onHand } : i).ToList();
    }

    private async Task SetLikedAsync(LikedByEntry entry, bool liked)
    {
        await Recipes.SetLikedAsync(Id, entry.Person.FamilyMemberId, liked);
        _likedBy = _likedBy.Select(e => e == entry ? e with { Liked = liked } : e).ToList();
    }

    private RenderFragment IngredientsHeader => @<div class="d-flex align-center flex-wrap gap-2">
        <MudText Typo="Typo.h6">Ingredients</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_ingredients.Count(i => i.OnHand) of @_ingredients.Count on hand</MudText>
    </div>;

    private RenderFragment IngredientsList => @<MudList T="string" Dense="true" Class="mt-2">
        @foreach (var line in _ingredients)
        {
            <MudListItem T="string">
                <div class="d-flex align-center">
                    <MudCheckBox T="bool" Value="line.OnHand" ValueChanged="@(onHand => SetOnHandAsync(line, onHand))" Color="Color.Success" Dense="true"
                                 aria-label="@($"I have {line.Name}")" />
                    <span class="ingredient-text @(line.OnHand ? "on-hand-text" : null)">
                        @if (!string.IsNullOrEmpty(line.Amount)) { <b>@line.Amount</b>@(" ") }@line.Name@(string.IsNullOrEmpty(line.Preparation) ? "" : $", {line.Preparation}")
                    </span>
                </div>
            </MudListItem>
        }
    </MudList>;

    private RenderFragment StepsList => @<div>
        @foreach (var (step, index) in _recipe!.Steps.Select((step, index) => (step, index)))
        {
            var done = _cooking && _doneSteps.Contains(index);
            <div class="d-flex gap-3 mb-4 @(done ? "step-done" : null)">
                @if (_cooking)
                {
                    <button type="button" class="step-number step-number-button" aria-pressed="@(done ? "true" : "false")"
                            aria-label="@($"Step {index + 1}: {(done ? "done, tap to untick" : "tap when done")}")"
                            @onclick="@(() => ToggleStepDone(index))">
                        @if (done)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                        else
                        {
                            @(index + 1)
                        }
                    </button>
                }
                else
                {
                    <div class="step-number">@(index + 1)</div>
                }
                <MudText Class="flex-grow-1 step-text" Style="white-space: pre-line; padding-top: 4px;">@step.Instruction</MudText>
                @if (_video is not null && step.VideoSeconds is { } seconds)
                {
                    var time = StepTime.Format(seconds);
                    <MudTooltip Text="@($"Play the video from {time}")">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="step-video-time"
                                   StartIcon="@Icons.Material.Filled.PlayCircle" aria-label="@($"Play step {index + 1} in the video, from {time}")"
                                   OnClick="@(() => SeekAsync(seconds))">@time</MudButton>
                    </MudTooltip>
                }
            </div>
        }
    </div>;

    private void ToggleStepDone(int index)
    {
        if (!_doneSteps.Remove(index))
        {
            _doneSteps.Add(index);
        }
    }

    private async Task EnterCookingModeAsync()
    {
        _cooking = true;
        try
        {
            _cookingModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Recipes/RecipeDetails.razor.js");
            _selfRef ??= DotNetObjectReference.Create(this);
            var state = await _cookingModule.InvokeAsync<CookingModeState>("enter", _selfRef);
            _fullscreenSupported = state.FullscreenSupported;
            _fullscreen = state.Fullscreen;
            _wakeLockSupported = state.WakeLockSupported;
            _screenAwake = state.ScreenAwake;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ExitCookingModeAsync()
    {
        _cooking = false;
        _fullscreen = false;
        _screenAwake = false;
        if (_cookingModule is not null)
        {
            try
            {
                await _cookingModule.InvokeVoidAsync("leave");
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_cookingModule is not null)
        {
            try
            {
                _fullscreen = await _cookingModule.InvokeAsync<bool>("setFullscreen", !_fullscreen);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OnFullscreenChanged(bool fullscreen) => InvokeAsync(() =>
    {
        _fullscreen = fullscreen;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnScreenAwakeChanged(bool awake) => InvokeAsync(() =>
    {
        _screenAwake = awake;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnEscape() => InvokeAsync(async () =>
    {
        if (_cooking)
        {
            await ExitCookingModeAsync();
            StateHasChanged();
        }
    });

    public async ValueTask DisposeAsync()
    {
        if (_cookingModule is not null)
        {
            try
            {
                await _cookingModule.InvokeVoidAsync("leave");
                await _cookingModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }

    private sealed record CookingModeState(bool FullscreenSupported, bool Fullscreen, bool WakeLockSupported, bool ScreenAwake);

    private Task SeekAsync(int seconds) => _player?.SeekAsync(seconds) ?? Task.CompletedTask;

    private Task AddToPlanAsync() => AddToMealPlanDialog.ShowAsync(Dialogs, Id, _recipe!.Title);

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Delete recipe",
            $"Delete \"{_recipe!.Title}\"? It will also be removed from any meal plans.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await Recipes.DeleteAsync(Id);
        Snackbar.Add($"Deleted {_recipe.Title}.", Severity.Info);
        Navigation.NavigateTo("recipes");
    }
}
