@page "/meal-plan"
@using CookHub.Data.Entities
@inject MealPlanService MealPlans
@inject RecipeService Recipes
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Meal plan · CookHub</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Meal plan</MudText>

<div class="d-flex align-center flex-wrap gap-2 mb-4">
    <WeekNavigator WeekStart="_weekStart" WeekStartChanged="ChangeWeek" />
    <MudSpacer />
    <MudToggleGroup T="MealPlanView" Value="_view" ValueChanged="ChangeView" SelectionMode="SelectionMode.SingleSelection"
                    Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false">
        <MudToggleItem Value="MealPlanView.List">
            <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />List</div>
        </MudToggleItem>
        <MudToggleItem Value="MealPlanView.Table">
            <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.CalendarViewWeek" Size="Size.Small" />Table</div>
        </MudToggleItem>
    </MudToggleGroup>
    <MudButton Href="@WeekQuery.Url("shopping-list", _weekStart)" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart">
        Shopping list@(MissingCount > 0 ? $" ({MissingCount})" : "")
    </MudButton>
</div>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <LookupAutocomplete ClearAfterSelect="true" OnSelected="AddRecipeAsync" Search="Recipes.SearchTitlesAsync"
                        Label="Add a recipe to this week" Placeholder="Search your recipes" Variant="Variant.Outlined" Margin="Margin.Dense" />
</MudPaper>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_view == MealPlanView.Table)
{
    <MealPlanTable WeekStart="_weekStart" Items="_items" OnAdd="OpenAddToCell" OnMove="MoveAsync" OnRemove="RemoveAsync" />
}
else if (_items.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-8 d-flex flex-column align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Secondary" />
        <MudText>Nothing planned for this week yet.</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Search above, or browse <MudLink Href="recipes" Typo="Typo.body2">your recipes</MudLink> and choose "Add to meal plan".</MudText>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true">
        <MudList T="string" Dense="false" Padding="false">
            @foreach (var item in _items)
            {
                <MudListItem T="string" @key="item.EntryId">
                    <div class="d-flex align-center flex-wrap gap-3">
                        <img src="@item.ImageUrl" alt="" class="recipe-thumb" />
                        <div class="flex-grow-1" style="min-width: 10rem;">
                            <MudLink Href="@($"recipes/{item.RecipeId}")" Typo="Typo.subtitle1" Color="Color.Inherit">@item.Title</MudLink>
                            <div><OnHandChip OnHand="item.OnHandCount" Total="item.IngredientCount" /></div>
                        </div>
                        <div class="d-flex gap-2">
                            <MudSelect T="DayOfWeek?" Value="item.Day" ValueChanged="@(day => SetDayAsync(item, day))" Label="Day"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 11rem;" Dense="true">
                                <MudSelectItem Value="@((DayOfWeek?)null)">Any day</MudSelectItem>
                                @foreach (var day in Week.Days)
                                {
                                    <MudSelectItem Value="@((DayOfWeek?)day)">@_weekStart.AddDays(Week.DayIndex(day)).ToString("ddd MMM d")</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="Meal?" Value="item.Meal" ValueChanged="@(meal => SetMealAsync(item, meal))" Label="Meal"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 9rem;" Dense="true">
                                <MudSelectItem Value="@((Meal?)null)">Any meal</MudSelectItem>
                                @foreach (var meal in Meals.All)
                                {
                                    <MudSelectItem Value="@((Meal?)meal)">@meal</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <MudTooltip Text="Remove from this week">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Remove from this week" OnClick="@(() => RemoveAsync(item))" />
                        </MudTooltip>
                    </div>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    </MudPaper>
}

<MudDialog @bind-Visible="_addOpen" Options="_addDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Add @(_addTarget.Meal.ToString().ToLowerInvariant())</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_weekStart.AddDays(Week.DayIndex(_addTarget.Day)).ToString("dddd MMM d")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_addOpen)
        {
            <LookupAutocomplete ClearAfterSelect="true" OnSelected="AddToCellAsync" Search="Recipes.SearchTitlesAsync"
                                Label="Recipe" Placeholder="Search your recipes" Variant="Variant.Outlined" AutoFocus="true" Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addOpen = false)">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _addDialogOptions = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

    private DateOnly _weekStart = Week.Current;
    private MealPlanView _view = MealPlanView.List;
    private IReadOnlyList<MealPlanItem>? _items;
    private bool _addOpen;
    private (DayOfWeek Day, Meal Meal) _addTarget;

    [SupplyParameterFromQuery(Name = "week")]
    public string? WeekParameter { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewParameter { get; set; }

    private int MissingCount => _items?.Sum(i => i.MissingCount) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        _weekStart = WeekQuery.Parse(WeekParameter);
        _view = MealPlanViews.Parse(ViewParameter);
        await LoadAsync();
    }

    private async Task LoadAsync() => _items = await MealPlans.GetWeekAsync(_weekStart);

    private void ChangeWeek(DateOnly weekStart) => Navigation.NavigateTo(MealPlanViews.Url(weekStart, _view));

    private void ChangeView(MealPlanView view) => Navigation.NavigateTo(MealPlanViews.Url(_weekStart, view));

    private void OpenAddToCell((DayOfWeek Day, Meal Meal) target)
    {
        _addTarget = target;
        _addOpen = true;
    }

    // Leaves the dialog open so several recipes can go in the same cell.
    private async Task AddToCellAsync(LookupItem recipe)
    {
        try
        {
            await MealPlans.AddAsync(recipe.Id, _weekStart, _addTarget.Day, _addTarget.Meal);
            Snackbar.Add($"Added {recipe.Name}.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }

    private async Task MoveAsync((MealPlanItem Item, DayOfWeek? Day, Meal? Meal) move)
    {
        await MealPlans.MoveAsync(move.Item.EntryId, move.Day, move.Meal);
        await LoadAsync();
    }

    private async Task SetMealAsync(MealPlanItem item, Meal? meal)
    {
        await MealPlans.SetMealAsync(item.EntryId, meal);
        await LoadAsync();
    }

    private async Task AddRecipeAsync(LookupItem recipe)
    {
        await MealPlans.AddAsync(recipe.Id, _weekStart);
        Snackbar.Add($"Added {recipe.Name}.", Severity.Success);
        await LoadAsync();
    }

    private async Task SetDayAsync(MealPlanItem item, DayOfWeek? day)
    {
        await MealPlans.SetDayAsync(item.EntryId, day);
        await LoadAsync();
    }

    private async Task RemoveAsync(MealPlanItem item)
    {
        await MealPlans.RemoveAsync(item.EntryId);
        await LoadAsync();
        Snackbar.Add($"Removed {item.Title} from this week.", Severity.Info, config =>
        {
            config.Action = "Undo";
            config.ActionColor = Color.Primary;
            config.OnClick = async _ =>
            {
                await MealPlans.AddAsync(item.RecipeId, _weekStart, item.Day, item.Meal);
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            };
        });
    }
}
