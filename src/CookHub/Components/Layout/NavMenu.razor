@implements IDisposable

@inject NavigationManager NavigationManager

<MudNavMenu Class="py-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="recipes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">Recipes</MudNavLink>
    <MudNavLink Href="meal-plan" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">Meal plan</MudNavLink>
    <MudNavLink Href="shopping-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">Shopping list</MudNavLink>
    <MudNavLink Href="on-hand" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Kitchen">On hand</MudNavLink>
    <MudNavLink Href="family" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FamilyRestroom">Family</MudNavLink>

    <MudDivider Class="my-2" />

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudNavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="mud-nav-link mud-ripple">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-3"></MudIcon> Log out
                </button>
            </form>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>


@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
